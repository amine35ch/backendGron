{
    "openapi": "3.0.0",
    "info": {
        "title": "API GRON",
        "description": "Documentation de l'API backend du projet GRON",
        "contact": {
            "email": "support@gron.fr",
            "name": "Support GRON"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "Serveur API principal"
        }
    ],
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Authentifier un utilisateur",
                "description": "Authentifie un utilisateur avec son nom d'utilisateur et son mot de passe",
                "operationId": "login",
                "requestBody": {
                    "description": "Informations d'authentification",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "username",
                                    "password",
                                    "company_code"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "example": "utilisateur"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "mot_de_passe"
                                    },
                                    "company_code": {
                                        "type": "string",
                                        "example": "CODE_ENTREPRISE"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Authentification réussie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                                        },
                                        "user": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "John Doe"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "john.doe@example.com"
                                                }
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentification échouée",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "failed"
                                        },
                                        "result": {
                                            "type": "string",
                                            "example": "Le mot de passe, identifiant ou le code saisi est incorrect."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/documentation/example": {
            "get": {
                "tags": [
                    "Documentation"
                ],
                "summary": "Exemple d'endpoint pour la documentation",
                "responses": {
                    "200": {
                        "description": "Exemple de réponse",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Ceci est un exemple d'API"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "Utilisez votre token JWT (Bearer <token>)"
            }
        },
        "schemas": {
            "Error": {
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string"
                    }
                },
                "type": "object"
            }
        }
    }
}